# Cloudflare Pages headers.
# Photos and the shared header assets are content-addressed by filename, so they
# can cache hard. HTML must not, or a stale schedule sits in someone's browser.

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The Pages preview address serves the same site. Keep it out of Google so
# talatabasketball.dk is the only copy that ranks (29 Oct 2026).
https://talata-website.pages.dev/*
  X-Robots-Tag: noindex

https://:version.talata-website.pages.dev/*
  X-Robots-Tag: noindex

# Every page. Revalidate each time so a fee or a training time is never stale.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
