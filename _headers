# Cloudflare Pages headers.
# Photos and the shared header assets are content-addressed by filename, so they
# can cache hard. HTML must not, or a stale schedule sits in someone's browser.

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The Pages preview address serves the same site. Keep it out of Google so
# talatabasketball.dk is the only copy that ranks (29 Oct 2026).
https://talata-website.pages.dev/*
  X-Robots-Tag: noindex

https://:version.talata-website.pages.dev/*
  X-Robots-Tag: noindex

# Every page. Revalidate each time so a fee or a training time is never stale.
# Content-Security-Policy added 29 Oct 2026 (website audit). Scripts only from
# our own files and Google Analytics, fetches only to us, the signup API and GA.
# Inline scripts stay allowed: the theme bootstrap and JSON-LD sit in every page.
# A new outside script, font or embed needs its address added here first.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://talata-api.coach-258.workers.dev https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://talata-api.coach-258.workers.dev https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
