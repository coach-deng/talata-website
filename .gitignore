.DS_Store
.wrangler/
node_modules/
CLAUDE_CONTEXT.md

# Raw photo dump — not for deployment
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.avif
*.JPG
*.JPEG
*.PNG
*.WEBP

# Sub-folders not part of the site
Photos-001
Photos-001\ (2)
Photos-001\ (3)
Photos-001\ (4)
Photos-001\ (5)
Photos-001\ (nene)
instagram_posts
Talata\ Website\ Photos

# Allow curated asset folders
!images/
!images/**
!camps/
!camps/**
!philosophy/
!philosophy/**

# Site icons — the *.png rule above would otherwise swallow these
!apple-touch-icon.png
!favicon.ico
!favicon.svg

# Junk photos — NEVER deploy (must come after the !images/** negation so it wins)
images/junk/
images/junk/**

# Unreferenced photos, moved out of the deploy Aug 6 2026. Still on disk, still
# in git history. Nothing on the site links to them and they were 61MB of raw
# phone shots going to Cloudflare on every push.
images/_unused/
images/_unused/**

# ...but partner logos ARE deployment assets. The blanket *.png above meant the
# EYBL logo only got committed because it was added by name; a plain `git add .`
# would have skipped it silently and the site would 404 the image.
!images/partners/
!images/partners/*.png
!images/partners/*.svg
!images/partners/*.webp
